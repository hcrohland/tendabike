#!/bin/sh

set -eu

# Redirect output to stderr.
exec 1>&2

protected_branch='main'
current_branch=$(git symbolic-ref --short HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
    echo "Direct commits to '$protected_branch' are not allowed. Create a feature branch instead."
    exit 1
fi

# --- console.log guard: always on, scoped to the staged diff ---
consoleregexp='^[^-].*(console\.log|@debug|\$inspect)'
filenamewithconsole='^[^-].*(console\.log|@debug|\$inspect)|^\+\+\+'
if test $(git diff --cached * | egrep $consoleregexp | wc -l) != 0
then
  echo do not commit console.log:
  exec git diff --cached * | egrep -ne $filenamewithconsole #| egrep -B 1 $consoleregexp
  exit 1; # THE USER DONT WANT TO CONTINUE SO ROLLBACK
fi

# --- language-scoped checks: run only what the staged files touch ---
# Staged files (added, copied, modified, renamed). Deletions need no checks.
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

run_rust=0
run_frontend=0

# Rust toolchain: any .rs file, a Cargo manifest/lock, or a backend SQL migration.
if printf '%s\n' "$staged_files" | grep -Eq '(\.rs$|Cargo\.(toml|lock)$|backend/.*\.sql$)'; then
    run_rust=1
fi

# Frontend toolchain: anything under frontend/.
if printf '%s\n' "$staged_files" | grep -Eq '^frontend/'; then
    run_frontend=1
fi

if [ "$run_rust" -eq 1 ]; then
    # ADR-0010: the entity owns its store — a store method is called only from
    # its owning entity's file (plus the store impls, doubles, tests, seed tool).
    python3 .githooks/check-store-access.py
    cargo fmt --check
    (cd backend/sqlx && cargo sqlx prepare --check)
    # --workspace --all-targets lints the #[cfg(test)]/test-support code too;
    # a bare `cargo clippy` only checks the default (lib/bin) targets and
    # silently skips the mock! witnesses and test-support modules.
    cargo clippy --workspace --all-targets -- -D warnings
    cargo check
fi

if [ "$run_frontend" -eq 1 ]; then
    npm run fmtcheck
    npm run check:ci
fi

# Dockerfile build-deps stubs: the image compiles from the manifests alone with
# real source stubbed out, so a [[bin]]/[lib] with no matching stub breaks the
# docker build — caught only by the slow remote docker CI job. Check locally.
if printf '%s\n' "$staged_files" | grep -Eq '^(Dockerfile|backend/[^/]+/Cargo\.toml)$'; then
    python3 .githooks/check-dockerfile-stubs.py
fi
