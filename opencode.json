{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "env": { "RUST_LOG": "debug" }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "provider": {
    "delphi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Delphi",
      "options": {
        "baseURL": "https://delphi.rohland.net/api/v1"
      },
      "models": {
        "Qwen3.6-MOE-4bit": {
          "name": "Qwen3.6-MOE-4bit",
          "limit": {
            "context": 130000,
            "output": 32000
          }
        },
        "Qwen3.6-MOE-6bit": {
          "name": "Qwen3.6-MOE-6bit",
          "limit": {
            "context": 130000,
            "output": 32000
          }
        },
        "Qwen3.8-4bit": {
          "name": "Qwen3.8-4bit",
          "options": {
            "reasoningEffort": "medium"
          },
          "limit": {
            "context": 100000,
            "output": 32000
          }
        }
      }
    }
  }
}
